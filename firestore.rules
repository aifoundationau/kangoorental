rules_version = '2';

// Kangoo Rental's database (kangoorental) is used only by the server, which connects with Google Cloud credentials
// and isn't subject to these rules. Browsers and apps can't read or write anything directly.
// Roles (supporter, admin, superadmin) are enforced by the server. The Firebase project owner's Google account is
// superadmin when it signs in with Google (SUPERADMIN_EMAILS in src/config.js).
// This matches the rules live on the kangoorental database as of 31 October 2026.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
