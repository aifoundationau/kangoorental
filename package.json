{
  "name": "kangoo-rental",
  "version": "1.0.0",
  "description": "Kangoo Rental - Renault Kangoo MAXI Diesel 1.5 Manual 6-Speed van hire in Wishart, Brisbane",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/aifoundationau/kangoorental.git"
  },
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch-path=src --watch-path=server.js server.js",
    "emulator": "firebase emulators:start --only firestore --project demo-kangoo",
    "dev:emulator": "node --watch-path=src --watch-path=server.js server.js --emulator",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "migrate-roles": "node --env-file-if-exists=.env scripts/migrate-roles.js",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@google/genai": "^2.32.0",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.2",
    "multer": "^2.5.0"
  }
}
