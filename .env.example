# Copy to .env and fill in. Never commit .env.

PORT=3000
BASE_URL=http://localhost:3000
# NODE_ENV=production        # enables secure cookies, HSTS and disables demo payments
# TRUST_PROXY=1              # set when running behind a load balancer / Cloud Run

# Firestore (native mode). Locally uses `gcloud auth application-default login`;
# on Google Cloud the service account is used automatically.
FIRESTORE_PROJECT_ID=ai-foundation-firebase
FIRESTORE_DATABASE_ID=kangoorental
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085   # use the local emulator instead of the live database

# Google accounts that become superadmin when they sign in with Google (comma-separated).
# Defaults to the Firebase project owner, support@aifoundation.net.au.
# SUPERADMIN_EMAILS=support@aifoundation.net.au

# First password superadmin (created on first start if none exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google Gemini licence verification. Without a key, licences go to manual admin review.
GEMINI_API_KEY=
# LICENCE_MODEL=gemini-3.8-flash

# Stripe token payments (charged in USD). Without a key, demo payments are used outside production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ALLOW_DEMO_PAYMENTS=false
